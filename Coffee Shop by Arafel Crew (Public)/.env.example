# ============================================================
# Area Barat POS — Environment Variables
# Salin nilai-nilai ini ke Vercel: Project → Settings → Environment Variables
# (file .env ini TIDAK dipakai di Vercel; hanya untuk development lokal)
# ============================================================

# --- Wajib untuk produksi (koneksi Google Spreadsheet) ---
# URL Web App Apps Script (lihat SETUP.md langkah 3)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOYMENT_KAMU/exec

# Kunci rahasia bridge — HARUS sama persis dengan BRIDGE_SECRET di apps-script/Code.gs
# Buat sendiri: openssl rand -base64 36  (minimal 32 karakter, jangan pakai contoh ini)
GOOGLE_SCRIPT_SECRET=GANTI_DENGAN_KUNCI_ACAK_MILIKMU

# --- Sangat disarankan (keamanan) ---
# Teks acak minimal 32 karakter untuk menandatangani sesi login.
# Kalau kosong, kunci sesi diturunkan dari GOOGLE_SCRIPT_SECRET (masih aman,
# tapi lebih baik dipisah). Contoh cara bikin: openssl rand -base64 48
SESSION_SECRET=

# --- Akun staff ---
# Akun kasir & bos TIDAK lagi lewat env var. Keduanya disimpan di database
# (tab Accounts) dan dikelola lewat Panel Bos → Akun Staff: ganti username,
# ganti password, tambah admin. Password default pertama: kasir/kasir, bos/bos.
# Segera ganti lewat Panel Bos setelah go-live.
#
# Hanya akun dev yang lewat env var (tidak bisa dibuat/diubah dari Panel Bos):
DEV_PASSWORD=